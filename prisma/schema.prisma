// FirmaQR — Modelo de datos
// PostgreSQL + Prisma ORM. Las tablas usan nombres en snake_case (@@map).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enumeraciones ─────────────────────────────

enum RoleName {
  ADMIN
  ORGANIZER
}

enum EventStatus {
  DRAFT // Borrador
  SCHEDULED // Programado
  ACTIVE // Activo
  FINALIZED // Finalizado
  CANCELLED // Cancelado
}

enum EventClassification {
  INTERNAL
  EXTERNAL
}

enum ClosingStatus {
  NONE
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum DuplicateRule {
  DOCUMENT // un registro por número de identificación
  DOCUMENT_AND_EMAIL // también un registro por correo
}

enum OtpChannel {
  EMAIL
  SMS
}

enum AttendanceStatus {
  STARTED // datos diligenciados, OTP enviado
  OTP_VERIFIED // identidad del canal verificada
  COMPLETED // firmado y confirmado
  VOIDED // anulado (con justificación auditada)
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  BLOCKED
  SUPERSEDED
}

enum ConsentType {
  SIGNATURE_AGREEMENT
  DATA_TREATMENT
}

enum DocumentType {
  ATTENDANCE_SHEET // planilla oficial PDF
  ATTENDANCE_XLSX
  RECEIPT // comprobante individual PDF
  CLOSING_REPORT_PDF
  CLOSING_REPORT_XLSX
}

enum ActorType {
  USER
  PARTICIPANT
  SYSTEM
}

enum EmailJobStatus {
  PENDING // en cola
  RETRYING // reintentando
  SENT_TO_PROVIDER // aceptado por el proveedor (NO implica entrega)
  DELIVERED // entrega confirmada por webhook del proveedor
  REJECTED // rechazado (dirección inválida, rebote permanente)
  FAILED // agotó reintentos
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  SMS
}

// ───────────────────────────── Usuarios ─────────────────────────────

model Role {
  id          Int      @id @default(autoincrement())
  name        RoleName @unique
  label       String
  description String?
  users       User[]

  @@map("roles")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  roleId       Int       @map("role_id")
  role         Role      @relation(fields: [roleId], references: [id])
  active       Boolean   @default(true)
  failedLogins Int       @default(0) @map("failed_logins")
  lockedUntil  DateTime? @map("locked_until")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions        Session[]
  organizedEvents Event[]     @relation("EventOrganizer")
  closedEvents    Event[]     @relation("EventClosedBy")
  createdEvents   Event[]     @relation("EventCreatedBy")
  auditLogs       AuditLog[]
  legalTexts      LegalText[]

  @@index([roleId])
  @@map("users")
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime @map("expires_at")
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ───────────────────────────── Configuración ─────────────────────────────

model AppSettings {
  id                Int      @id @default(1)
  companyName       String   @default("Mi Empresa S.A.S.") @map("company_name")
  companyNit        String?  @map("company_nit")
  logoPath          String?  @map("logo_path")
  logoMime          String?  @map("logo_mime")
  formatCode        String   @default("11020001F-01") @map("format_code")
  formatVersion     String   @default("V0.6") @map("format_version")
  sheetTitle        String   @default("REGISTRO DE ASISTENCIA") @map("sheet_title")
  sheetShowSignature Boolean @default(true) @map("sheet_show_signature")
  sheetLegalNotice  String?  @map("sheet_legal_notice")
  receiptFooterNote String?  @map("receipt_footer_note")
  supportEmail      String?  @map("support_email")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// Textos jurídicos versionados (acuerdo de firma electrónica, tratamiento de datos).
model LegalText {
  id          String      @id @default(cuid())
  type        ConsentType
  version     String
  title       String
  content     String
  sha256      String
  active      Boolean     @default(false)
  createdById String?     @map("created_by_id")
  createdBy   User?       @relation(fields: [createdById], references: [id])
  createdAt   DateTime    @default(now()) @map("created_at")

  consents ConsentRecord[]

  @@unique([type, version])
  @@index([type, active])
  @@map("legal_texts")
}

// ───────────────────────────── Eventos ─────────────────────────────

model Event {
  id                 String              @id @default(cuid())
  code               String              @unique // EV-2026-00001
  program            String
  topic              String
  relatedDocument    String?             @map("related_document")
  name               String
  description        String?
  trainer            String
  institution        String
  classification     EventClassification
  date               DateTime            @db.Date
  startTime          String              @map("start_time") // HH:MM (America/Bogota)
  endTime            String              @map("end_time")
  durationHours      Decimal             @map("duration_hours") @db.Decimal(5, 2)
  location           String
  organizerId        String              @map("organizer_id")
  organizer          User                @relation("EventOrganizer", fields: [organizerId], references: [id])
  createdById        String              @map("created_by_id")
  createdBy          User                @relation("EventCreatedBy", fields: [createdById], references: [id])
  status             EventStatus         @default(DRAFT)
  otpChannel         OtpChannel          @default(EMAIL) @map("otp_channel")
  requireDataConsent Boolean             @default(true) @map("require_data_consent")
  duplicateRule      DuplicateRule       @default(DOCUMENT) @map("duplicate_rule")
  closingStatus      ClosingStatus       @default(NONE) @map("closing_status")
  closingReport      Json?               @map("closing_report")
  closingError       String?             @map("closing_error")
  closedAt           DateTime?           @map("closed_at")
  closedById         String?             @map("closed_by_id")
  closedBy           User?               @relation("EventClosedBy", fields: [closedById], references: [id])
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  fields            EventField[]
  qr                EventQr?
  attendees         Attendee[]
  attendanceRecords AttendanceRecord[]
  documents         Document[]
  emailJobs         EmailJob[]
  auditLogs         AuditLog[]

  @@index([status])
  @@index([organizerId])
  @@index([date])
  @@map("events")
}

// Campos que se solicitan a los participantes en el formulario público.
model EventField {
  id       String  @id @default(cuid())
  eventId  String  @map("event_id")
  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  key      String // documentNumber | fullName | email | company | management | area | phone
  label    String
  enabled  Boolean @default(true)
  required Boolean @default(true)
  order    Int     @default(0)

  @@unique([eventId, key])
  @@map("event_fields")
}

// QR exclusivo del evento. El token es aleatorio y no contiene datos personales.
model EventQr {
  id            String    @id @default(cuid())
  eventId       String    @unique @map("event_id")
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  token         String    @unique
  active        Boolean   @default(true)
  scans         Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at")
  rotatedAt     DateTime? @map("rotated_at")
  deactivatedAt DateTime? @map("deactivated_at")

  @@map("event_qr")
}

// ───────────────────────────── Participantes y asistencia ─────────────────────────────

model Attendee {
  id                 String   @id @default(cuid())
  eventId            String   @map("event_id")
  event              Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  documentNumberEnc  String   @map("document_number_enc") // AES-256-GCM
  documentNumberHash String   @map("document_number_hash") // HMAC-SHA256 (índice ciego)
  fullName           String   @map("full_name")
  company            String?
  management         String?
  area               String?
  email              String
  emailNormalized    String   @map("email_normalized")
  phoneEnc           String?  @map("phone_enc")
  phoneLast4         String?  @map("phone_last4")
  createdAt          DateTime @default(now()) @map("created_at")

  attendanceRecord AttendanceRecord?

  @@index([eventId, documentNumberHash])
  @@index([eventId, emailNormalized])
  @@map("attendees")
}

model AttendanceRecord {
  id                    String           @id @default(uuid()) @db.Uuid
  evidenceCode          String           @unique @map("evidence_code") // FQR-XXXX-XXXX-XXXX
  eventId               String           @map("event_id")
  event                 Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  attendeeId            String           @unique @map("attendee_id")
  attendee              Attendee         @relation(fields: [attendeeId], references: [id], onDelete: Restrict)
  status                AttendanceStatus @default(STARTED)
  sequence              Int? // número consecutivo en la planilla (asignado al consolidar)
  documentNumberHash    String           @map("document_number_hash")
  emailNormalized       String           @map("email_normalized")
  registrationTokenHash String           @unique @map("registration_token_hash")
  registrationExpiresAt DateTime         @map("registration_expires_at")
  authMethod            String?          @map("auth_method") // EMAIL_OTP | SMS_OTP
  authDestinationMasked String?          @map("auth_destination_masked")
  ip                    String?
  userAgent             String?          @map("user_agent")
  startedAt             DateTime         @default(now()) @map("started_at")
  otpVerifiedAt         DateTime?        @map("otp_verified_at")
  completedAt           DateTime?        @map("completed_at")
  evidenceJson          Json?            @map("evidence_json")
  evidenceHash          String?          @map("evidence_hash") // SHA-256 del paquete de evidencia
  voidedAt              DateTime?        @map("voided_at")
  voidReason            String?          @map("void_reason")

  signature        Signature?
  otpVerifications OtpVerification[]
  consents         ConsentRecord[]
  documents        Document[]
  emailJobs        EmailJob[]

  @@index([eventId, status])
  @@index([eventId, documentNumberHash])
  @@index([eventId, emailNormalized])
  @@map("attendance_records")
}

model Signature {
  id                 String           @id @default(cuid())
  attendanceRecordId String           @unique @map("attendance_record_id") @db.Uuid
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict)
  imagePath          String           @map("image_path")
  imageSha256        String           @map("image_sha256")
  width              Int
  height             Int
  strokeCount        Int              @map("stroke_count")
  pointCount         Int              @map("point_count")
  drawDurationMs     Int?             @map("draw_duration_ms")
  pointerType        String?          @map("pointer_type") // mouse | touch | pen
  deviceInfo         Json?            @map("device_info")
  ip                 String?
  userAgent          String?          @map("user_agent")
  capturedAt         DateTime         @default(now()) @map("captured_at")

  @@map("signatures")
}

model OtpVerification {
  id                 String           @id @default(cuid())
  attendanceRecordId String           @map("attendance_record_id") @db.Uuid
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict)
  channel            OtpChannel
  destinationMasked  String           @map("destination_masked")
  destinationHash    String           @map("destination_hash")
  codeHash           String           @map("code_hash")
  status             OtpStatus        @default(PENDING)
  attempts           Int              @default(0)
  maxAttempts        Int              @default(5) @map("max_attempts")
  expiresAt          DateTime         @map("expires_at")
  sentAt             DateTime         @default(now()) @map("sent_at")
  verifiedAt         DateTime?        @map("verified_at")
  providerMessageId  String?          @map("provider_message_id")
  ip                 String?
  createdAt          DateTime         @default(now()) @map("created_at")

  @@index([attendanceRecordId, status])
  @@index([destinationHash, createdAt])
  @@map("otp_verifications")
}

model ConsentRecord {
  id                 String           @id @default(cuid())
  attendanceRecordId String           @map("attendance_record_id") @db.Uuid
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict)
  type               ConsentType
  legalTextId        String           @map("legal_text_id")
  legalText          LegalText        @relation(fields: [legalTextId], references: [id])
  version            String
  textSha256         String           @map("text_sha256")
  accepted           Boolean
  acceptedAt         DateTime         @default(now()) @map("accepted_at")
  ip                 String?
  userAgent          String?          @map("user_agent")

  @@unique([attendanceRecordId, type])
  @@map("consent_records")
}

// ───────────────────────────── Documentos ─────────────────────────────

model Document {
  id                 String            @id @default(cuid())
  type               DocumentType
  eventId            String            @map("event_id")
  event              Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  attendanceRecordId String?           @map("attendance_record_id") @db.Uuid
  attendanceRecord   AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict)
  verificationCode   String            @unique @map("verification_code")
  idempotencyKey     String            @unique @map("idempotency_key")
  storagePath        String            @map("storage_path")
  fileName           String            @map("file_name")
  mimeType           String            @map("mime_type")
  sizeBytes          Int               @map("size_bytes")
  sha256             String
  isFinal            Boolean           @default(true) @map("is_final")
  createdAt          DateTime          @default(now()) @map("created_at")

  emailJobs EmailJob[]

  @@index([eventId, type])
  @@index([attendanceRecordId])
  @@index([sha256])
  @@map("documents")
}

// ───────────────────────────── Auditoría ─────────────────────────────

// Bitácora encadenada por hash (cada fila incluye el hash de la anterior).
// Un trigger de base de datos impide UPDATE y DELETE.
model AuditLog {
  id          BigInt    @id @default(autoincrement())
  createdAt   DateTime  @default(now()) @map("created_at")
  actorType   ActorType @map("actor_type")
  actorUserId String?   @map("actor_user_id")
  actorUser   User?     @relation(fields: [actorUserId], references: [id])
  actorLabel  String?   @map("actor_label")
  action      String
  entityType  String    @map("entity_type")
  entityId    String?   @map("entity_id")
  eventId     String?   @map("event_id")
  event       Event?    @relation(fields: [eventId], references: [id])
  ip          String?
  userAgent   String?   @map("user_agent")
  details     Json?
  prevHash    String    @map("prev_hash")
  hash        String    @unique

  @@index([eventId])
  @@index([action])
  @@index([createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}

// ───────────────────────────── Notificaciones / correo ─────────────────────────────

model EmailJob {
  id                 String            @id @default(cuid())
  idempotencyKey     String            @unique @map("idempotency_key")
  type               String            @default("RECEIPT")
  eventId            String            @map("event_id")
  event              Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  attendanceRecordId String?           @map("attendance_record_id") @db.Uuid
  attendanceRecord   AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict)
  documentId         String?           @map("document_id")
  document           Document?         @relation(fields: [documentId], references: [id])
  recipient          String
  subject            String
  status             EmailJobStatus    @default(PENDING)
  attempts           Int               @default(0)
  maxAttempts        Int               @default(5) @map("max_attempts")
  nextAttemptAt      DateTime          @default(now()) @map("next_attempt_at")
  lockedAt           DateTime?         @map("locked_at")
  lockedBy           String?           @map("locked_by")
  lastError          String?           @map("last_error")
  provider           String?
  providerMessageId  String?           @map("provider_message_id")
  sentAt             DateTime?         @map("sent_at")
  deliveredAt        DateTime?         @map("delivered_at")
  isManualResend     Boolean           @default(false) @map("is_manual_resend")
  requestedById      String?           @map("requested_by_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  notifications NotificationLog[]

  @@index([status, nextAttemptAt])
  @@index([eventId])
  @@index([attendanceRecordId])
  @@index([providerMessageId])
  @@map("email_jobs")
}

// Historial de cada intento de envío y evento del proveedor (OTP y comprobantes).
model NotificationLog {
  id                String              @id @default(cuid())
  emailJobId        String?             @map("email_job_id")
  emailJob          EmailJob?           @relation(fields: [emailJobId], references: [id])
  channel           NotificationChannel
  kind              String // OTP | RECEIPT | WEBHOOK
  recipientMasked   String              @map("recipient_masked")
  status            String
  provider          String?
  providerMessageId String?             @map("provider_message_id")
  error             String?
  details           Json?
  createdAt         DateTime            @default(now()) @map("created_at")

  @@index([emailJobId])
  @@index([createdAt])
  @@map("notification_logs")
}
