# ───────────── FirmaQR · Variables de entorno ─────────────
# Copie este archivo a .env y reemplace TODOS los valores de ejemplo.

# Base de datos PostgreSQL
# Con pooler (Neon, Supabase, Vercel Postgres): DATABASE_URL = URL "pooled" (agregue ?pgbouncer=true si es PgBouncer)
# y DIRECT_URL = URL directa (se usa para migraciones). Sin pooler, ambas iguales.
DATABASE_URL="postgresql://firmaqr:CAMBIAR@localhost:5432/firmaqr?schema=public"
DIRECT_URL="postgresql://firmaqr:CAMBIAR@localhost:5432/firmaqr?schema=public"

# URL pública HTTPS de la aplicación (se usa en el QR, comprobantes y verificación)
APP_URL="https://firmaqr.suempresa.com.co"

# Seguridad (OBLIGATORIAS en producción)
# Clave AES-256 de 32 bytes en base64:  openssl rand -base64 32
APP_ENCRYPTION_KEY=""
# Secreto para índices ciegos (HMAC):     openssl rand -hex 32
HASH_PEPPER=""
# Secreto para los códigos OTP:           openssl rand -hex 32
OTP_SECRET=""
# Horas de vigencia de la sesión de usuarios internos
SESSION_HOURS=8
# true si la app está detrás de un proxy inverso que fija X-Forwarded-For (Nginx, balanceador)
TRUST_PROXY=true

# ───────────── Almacenamiento privado de firmas y documentos ─────────────
# local = disco (servidor propio / Docker) · s3 = bucket S3 compatible PRIVADO · supabase = Supabase Storage privado
# (en Vercel use s3 o supabase)
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
# S3 / Cloudflare R2 / Supabase Storage / MinIO (bucket privado, sin acceso público)
S3_BUCKET=""
S3_REGION="auto"
# Endpoint solo para proveedores distintos de AWS, p. ej. https://<cuenta>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PREFIX="firmaqr/"
S3_FORCE_PATH_STYLE=false
# Cifrado en reposo del lado del servidor (AWS: AES256). Déjelo vacío en R2.
S3_SSE=""
# Supabase Storage (STORAGE_DRIVER=supabase): clave service_role, solo del lado del servidor
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="firmaqr"

# ───────────── Correo transaccional ─────────────
# EMAIL_PROVIDER: smtp | ses (vía SMTP) | resend | sendgrid | file (desarrollo: guarda en storage/outbox)
EMAIL_PROVIDER="smtp"
EMAIL_FROM="no-reply@suempresa.com.co"
EMAIL_FROM_NAME="FirmaQR - Su Empresa"
# API key para resend / sendgrid
EMAIL_API_KEY=""
# SMTP seguro (puerto 587 STARTTLS o 465 TLS)
SMTP_HOST="smtp.suempresa.com.co"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
# Secreto compartido del webhook de confirmación de entrega: /api/webhooks/email?token=...
EMAIL_WEBHOOK_SECRET=""

# Cola de correos: true = la app procesa la cola al cerrar eventos (en Vercel, con after()).
# Con worker dedicado (npm run worker) puede usarse false.
# Secreto para /api/cron/email-queue (Vercel Cron lo envía automáticamente):  openssl rand -hex 32
CRON_SECRET=""
QUEUE_INLINE=true
WORKER_INTERVAL_MS=15000

# ───────────── SMS (OTP por celular, opcional) ─────────────
# SMS_PROVIDER: console (desarrollo) | twilio
SMS_PROVIDER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# ───────────── Instalación inicial ─────────────
# Código que pide la página /instalar para crear el primer administrador (recomendado en producción)
SETUP_TOKEN=""

# ───────────── Carga inicial por consola (npm run db:seed), alternativa a /instalar ─────────────
SEED_ADMIN_EMAIL="admin@suempresa.com.co"
SEED_ADMIN_PASSWORD=""
SEED_COMPANY_NAME="Su Empresa S.A.S."

# Solo desarrollo: muestra el OTP en pantalla (ignorado en producción)
OTP_DEV_ECHO=false
