# ───────────── FirmaQR · Variables de entorno ─────────────
# Copie este archivo a .env y reemplace TODOS los valores de ejemplo.

# Base de datos PostgreSQL
DATABASE_URL="postgresql://firmaqr:CAMBIAR@localhost:5432/firmaqr?schema=public"

# URL pública HTTPS de la aplicación (se usa en el QR, comprobantes y verificación)
APP_URL="https://firmaqr.suempresa.com.co"

# Seguridad (OBLIGATORIAS en producción)
# Clave AES-256 de 32 bytes en base64:  openssl rand -base64 32
APP_ENCRYPTION_KEY=""
# Secreto para índices ciegos (HMAC):     openssl rand -hex 32
HASH_PEPPER=""
# Secreto para los códigos OTP:           openssl rand -hex 32
OTP_SECRET=""
# Horas de vigencia de la sesión de usuarios internos
SESSION_HOURS=8
# true si la app está detrás de un proxy inverso que fija X-Forwarded-For (Nginx, balanceador)
TRUST_PROXY=true

# Almacenamiento privado de documentos y firmas (fuera de /public, con copias de seguridad)
STORAGE_DIR="./storage"

# ───────────── Correo transaccional ─────────────
# EMAIL_PROVIDER: smtp | ses (vía SMTP) | resend | sendgrid | file (desarrollo: guarda en storage/outbox)
EMAIL_PROVIDER="smtp"
EMAIL_FROM="no-reply@suempresa.com.co"
EMAIL_FROM_NAME="FirmaQR - Su Empresa"
# API key para resend / sendgrid
EMAIL_API_KEY=""
# SMTP seguro (puerto 587 STARTTLS o 465 TLS)
SMTP_HOST="smtp.suempresa.com.co"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
# Secreto compartido del webhook de confirmación de entrega: /api/webhooks/email?token=...
EMAIL_WEBHOOK_SECRET=""

# Cola de correos: true = la app procesa la cola al cerrar eventos (instancia única).
# Con worker dedicado (npm run worker) puede usarse false.
QUEUE_INLINE=true
WORKER_INTERVAL_MS=15000

# ───────────── SMS (OTP por celular, opcional) ─────────────
# SMS_PROVIDER: console (desarrollo) | twilio
SMS_PROVIDER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# ───────────── Carga inicial (npm run db:seed) ─────────────
SEED_ADMIN_EMAIL="admin@suempresa.com.co"
SEED_ADMIN_PASSWORD=""
SEED_COMPANY_NAME="Su Empresa S.A.S."

# Solo desarrollo: muestra el OTP en pantalla (ignorado en producción)
OTP_DEV_ECHO=false
